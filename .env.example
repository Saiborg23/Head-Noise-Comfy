# Comfy API v2 endpoint. Unset = Comfy Cloud. Local: http://127.0.0.1:8289 (comfy-api-proxy). Deployment: https://<name>.run.comfy.app
COMFY_BASE_URL=
# Comfy API key (Comfy Cloud) or workspace key (deployment). Not needed for the local proxy.
COMFY_API_KEY=
# cloud = core nodes only (TRIBE served from cache by the backend), custom = the comfyui-head-noise pack is installed
HEAD_NOISE_TARGET=
